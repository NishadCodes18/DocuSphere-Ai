# Neon Cloud PostgreSQL Connection URL (keep neon sql only)
DATABASE_URL=postgresql+psycopg://<username>:<password>@<neon_endpoint>.neon.tech/neondb?sslmode=require&channel_binding=require

# AI Engine Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
GEMINI_API_KEY=
OPENAI_API_KEY=

# Vector & Retrieval Settings
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
TOP_K=8

# CORS (include your Vercel deployment domain)
CORS_ORIGINS=http://localhost:3000,https://*.vercel.app
MAX_UPLOAD_MB=25
